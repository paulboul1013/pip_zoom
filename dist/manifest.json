{
  "manifest_version": 3,
  "name": "PiP Zoom",
  "version": "0.1.0",
  "description": "將網頁影片的選取區域顯示為子母畫面。",
  "action": {
    "default_title": "選取影片範圍並啟動 PiP",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"]
}
